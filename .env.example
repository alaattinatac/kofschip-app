# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Google Gemini AI ---
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- RevenueCat (In-App Purchases) ---
VITE_REVENUECAT_API_KEY=your-revenuecat-api-key-here

# --- AdMob (Free Tier Ads) ---
VITE_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
VITE_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# --- App Config ---
VITE_APP_ENV=development
VITE_FREE_DAILY_SCAN_LIMIT=3
VITE_PREMIUM_PRICE=14.99
VITE_PREMIUM_CURRENCY=EUR
